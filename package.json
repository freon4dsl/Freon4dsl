{
    "name": "freon4dsl",
    "type": "module",
    "private": true,
    "scripts": {
        "rebuild": "npm run clean && npm install && npm run build && npm run test",
        "rebuild-local": "npm run clean && npm run install-local && npm run build && npm run test",
        "rebuild-dev": "npm run clean && npm install && npm run build-dev",
        "rebuild-dev-local": "npm run clean && npm run install-local && npm run build-dev",
        "clean": "rm -f package-lock.json && rm -rf node_modules/ && npm run clean --workspaces --if-present",
        "clean-all": "npm run clean-all --workspaces --if-present",
        "start": "npm run start --stream --parallel",
        "build": "npm run build --workspaces --if-present",
        "build-dev": "npm run build-dev --workspaces --if-present",
        "build-release": "npm run build-release --workspaces --if-present",
        "build-samples": "npm run build-samples --workspaces --if-present",
        "clean-custom-samples": "npm run clean-custom --workspaces --if-present",
        "publish-local": "npm run publish-local --workspaces --if-present",
        "unpublish-local": "npm run unpublish-local --workspaces --if-present",
        "republish-local": "npm run unpublish-local && npm run publish-local",
        "install-local": "npm install --registry http://localhost:4873",
        "lint": "npm run lint --workspaces --if-present",
        "setup": "npm run setup --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "release-beta": "npm run release-beta --workspaces --if-present",
        "prettier": "prettier --write --print-width 120 --tab-width 4 packages/*/src/**/*.ts packages/*/src/**/*.tsx packages/*/src/**/*.css",
        "check-imports": "npm run check-imports --workspaces --if-present",
        "check-dependencies": "npx  syncpack lint --source 'package.json' --source 'packages/*/package.json'",
        "list-dependencies": "npx  syncpack list --source 'package.json' --source 'packages/*/package.json'"
    },
    "devDependencies": {
        "@eslint/compat": "2.0.2",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "10.0.1",
        "@prettier/sync": "^0.5.2",
        "@tsconfig/svelte": "5.0.4",
        "@types/node": "24.0.14",
        "@types/pegjs": "0.10.6",
        "@typescript-eslint/utils": "8.56.1",
        "@vitest/eslint-plugin": "1.6.9 ",
        "cross-env": "7.0.3",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-node": "11.1.0",
        "identity-obj-proxy": "3.0.0",
        "nodemon": "3.1.3",
        "patch-package": "^8.0.1",
        "pegjs": "0.10.0",
        "reflect-metadata": "0.2.2",
        "svelte-check": "4.4.4",
        "svelte-eslint-parser": "1.6.1",
        "svelte-language-server": "^0.17.29",
        "ts-node": "^10.9.2",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.59.2",
        "typescript-svelte-plugin": "^0.3.50"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "workspaces": [
        "packages/core",
        "packages/core-svelte",
        "packages/meta",
        "packages/test-helpers",
        "packages/samples/*",
        "packages/weblib-flowbite",
        "packages/webapp-flowbite",
        "packages/server",
        "packages/test"
    ],
    "version": "3.0.0-beta.1",
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-keywords": "^5.1.0"
    }
}
