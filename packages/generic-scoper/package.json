{
    "name": "@freon4dsl/generic-scoper",
    "version": "3.0.0-beta.1",
    "description": "Generic namespace and scoping infrastructure for model-based languages",
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/freon4dsl/Freon4dsl.git"
    },
    "files": [
        "dist",
        "src",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "scripts": {
        "build": "tsc",
        "build-dev": "tsc",
        "build-release": "tsc",
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "format": "prettier --write .",
        "lint": "eslint",
        "test": "vitest run",
        "release-beta": "npm publish --tag beta",
        "publish-local": "npm publish --registry http://localhost:4873 --tag local",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local",
        "check-imports": "bash ../../scripts/check-import-extensions.sh"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.14",
        "prettier": "3.8.3",
        "typescript": "5.9.3",
        "vite": "8.1.3",
        "vitest": "4.1.4"
    }
}
