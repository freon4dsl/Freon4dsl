{
    "name": "@freon4dsl/webapp-flowbite",
    "version": "2.1.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "clean": "rm -rf node_modules/",
        "build": "echo No build for webapp-flowbite",
        "build-app": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "start": "sirv public --port 8000",
        "validate": "svelte-check --tsconfig ./tsconfig.json",
        "errors-only": "svelte-check --threshold error --tsconfig ./tsconfig.json",
        "install-local": "npm install --registry http://localhost:4873",
        "format": "prettier --write .",
        "styles": "cross-env NODE_ENV=production npx @tailwindcss/cli -i styles/webapp-styles.css -o ./public/site.css --minify"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.0.0",
        "@tailwindcss/vite": "^4.1.10",
        "@tailwindcss/cli": "^4.1.10",
        "@tsconfig/svelte": "^5.0.4",
        "svelte-check": "^4.4.4",
        "svelte-preprocess": "^6.0.3",
        "tailwindcss": "^4.1.4",
        "typescript": "5.9.3",
        "vite": "8.0.8"
    },
    "dependencies": {
        "embla-carousel-svelte": "^9.0.0-rc01",
        "phosphor-svelte": "^3.1.0",
        "@lucide/svelte": "^0.513.0",
        "@freon4dsl/core": "~2.1.0",
        "@freon4dsl/core-svelte": "~2.1.0",
        "@freon4dsl/weblib-flowbite": "~2.1.0",
        "@freon4dsl/samples-scoping-example": "~2.1.0",
        "@freon4dsl/samples-course-schedule": "~2.1.0",
        "@freon4dsl/samples-insurance": "~2.1.0",
        "@freon4dsl/samples-example": "~2.1.0",
        "@types/node": "^24.0.14",
        "kotlin": "^1.5.21",
        "mobx": "6.15.0",
        "mobx-utils": "^6.0.8",
        "sirv-cli": "^2.0.2",
        "svelte": "5.55.4",
        "tslib": "2.8.1"
    }
}
