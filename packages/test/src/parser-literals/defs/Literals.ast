language LiteralsTest

// Primitive values the writer writes and the reader must read back unchanged:
// booleans with language-specific keywords, strings containing quotes,
// backslashes, and newlines, and identifiers (names, and references to them)
// in any script and containing backticks, backslashes, dots, and spaces.

model LiteralsModel {
    name: identifier;
    units: Literals[];
}

modelunit Literals {
    name: identifier;
    flag: boolean;
    other: boolean;
    flags: boolean[];
    text: string;
    texts: string[];
    ids: identifier[];
    items: Item[];
    reference chosen?: Item;
    file-extension = "lit";
}

concept Item {
    name: identifier;
}
