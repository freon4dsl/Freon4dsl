language LiteralsTest

// Primitive values the writer writes and the reader must read back unchanged:
// booleans with language-specific keywords, strings containing quotes,
// backslashes, and newlines, and negative numbers.

model LiteralsModel {
    name: identifier;
    units: Literals[];
}

modelunit Literals {
    name: identifier;
    flag: boolean;
    other: boolean;
    flags: boolean[];
    text: string;
    texts: string[];
    count: number;
    counts: number[];
    file-extension = "lit";
}
