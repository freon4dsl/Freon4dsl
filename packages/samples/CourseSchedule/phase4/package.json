{
  "name": "@freon4dsl/webapp-starter",
  "version": "3.0.0-beta.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/",
    "build": "echo No build for webapp-starter",
    "build-samples": "npm run build",
    "build-app": "tsc",
    "start": "sirv public --port 8000",
    "validate": "svelte-check --tsconfig ./tsconfig.json",
    "errors-only": "svelte-check --threshold error --tsconfig ./tsconfig.json",
    "install-local": "npm install --registry http://localhost:4873",
    "prepare-app": "npm run styles-light && npm run styles-dark",
    "styles-light": "smui-theme compile public/site.css -i style",
    "styles-dark": "smui-theme compile public/site-dark.css -i style/dark"
  },
  "devDependencies": {
    "@smui-extra/accordion": "8.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "smui-theme": "8.0.3",
    "svelte-check": "^4.4.4",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@freon4dsl/core": "~3.0.0-beta.1",
    "@freon4dsl/core-svelte": "~3.0.0-beta.1",
    "@freon4dsl/samples-course-schedule": "~3.0.0-beta.1",
    "@freon4dsl/webapp-lib": "~3.0.0-beta.1",
    "@smui/snackbar": "8.0.3",
    "@smui-extra/accordion": "8.0.3",
    "@types/node": "^25.6.2",
    "kotlin": "^1.5.21",
    "mobx": "6.15.0",
    "mobx-utils": "^6.0.8",
    "net.akehurst.language-agl-processor": "4.2.1-20-RC2",
    "sirv-cli": "^2.0.2",
    "tslib": "2.8.1"
  }
}
