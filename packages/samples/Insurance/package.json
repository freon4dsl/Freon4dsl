{
    "name": "@freon4dsl/samples-insurance",
    "version": "3.0.0-beta.1",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "rm -rf node_modules/",
        "build": "npm run generate && tsc",
        "build-samples": "npm run build",
        "compile": "tsc",
        "test": "vitest run",
        "install-local": "npm install --registry http://localhost:4873",
        "generate": "bash ../../../scripts/freon-samples-dev.sh -v all -d src/defs",
        "clean-gen": "bash ../../../scripts/freon-samples-dev.sh clean-it -d src/defs",
        "clean-config": "rm */config/FreonConfiguration.ts",
        "clean-custom": "rm */*/Custom*.ts",
        "clean-all": "npm run clean-gen && npm run clean-config && npm run clean-custom"
    },
    "devDependencies": {
        "@freon4dsl/meta": "~3.0.0-beta.1",
        "@freon4dsl/test-helpers": "~3.0.0-beta.1"
    },
    "dependencies": {
        "@freon4dsl/core": "~3.0.0-beta.1",
        "@types/node": "^25.6.2",
        "kotlin": "^1.5.21",
        "mobx": "6.15.0",
        "mobx-utils": "^6.0.8",
        "net.akehurst.language-agl-processor": "4.2.1-20-RC2",
        "tslib": "2.8.1"
    }
}
