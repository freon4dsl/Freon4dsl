    mandatory containment `properties` ( "-key-ObjectType-properties" ): `PropertyDef` *
}
interface `Type` extends {
    key: "-key-Type"
    mandatory property `name` ( "-key-Type-name" ): `String`
concrete concept `Types` implements {
    key: "-key-Types"
