}
concrete concept `PropertyDef` implements {
    key: "-key-PropertyDef"
    partition: false
    mandatory reference `type` ( "-key-PropertyDef-type" ): `Type` 1
    mandatory property `name` ( "-key-PropertyDef-name" ): `String`
