language `Protocol` key "-key-Protocol"
version "version?"
depends on languages:

concrete concept `MessageGroup` implements `Type` {
    key: "-key-MessageGroup"
    partition: true
    mandatory containment `sharedProperties` ( "-key-MessageGroup-sharedProperties" ): `PropertyDef` *
    mandatory property `taggedUnionProperty` ( "-key-MessageGroup-taggedUnionProperty" ): `String`
