// -------------------- Editors for modelunits --------------------
editor default

global {
    external {
        DatePicker,
        DateRangePicker,
        TimeRangePicker,
        TimePicker,
        AvailabilityPicker,
        HorizontalAccordion,
        VerticalAccordion
    }
}

FestivalOverview {[
Festival overview

    Name: ${self.name}
    Location: ${self.location}
    [fragment startAndEndDate]
    Status: ${self.status radio}
]
fragment startAndEndDate [
    Dates: ${self.dates replace=DateRangePicker}
]}

Schedule {[
Schedule

    ${self.days replace=HorizontalAccordion}
]}

Resources {[
Resources

    Staff:
    ${self.staff}

    Equipment:
    ${self.equipment}

    Vendors:
    ${self.vendors}
]}

TicketCatalog {[
Tickets

    ${self.ticketTypes}
]}

ComplianceDossier {[
Compliance

    ${self.compliance}
]}

Day {[
  Date: ${self.date replace=DatePicker}
  Stages: ${self.stages replace=VerticalAccordion}
  Logistics: ${self.logistics}
]}

Performance {[
  Artist: ${self.artist}
  On from ${self.timeSlot replace=TimeRangePicker}
  TechnicalRequirements: ${self.technicalRequirements}
]}

Logistics {[
  Load in at: ${self.loadInTime replace=TimePicker} Load out at: ${self.loadOutTime replace=TimePicker}
  Security plan: ${self.securityPlanReference}
  Catering: ${self.cateringArrangements}
]}

Staff {[
  Name: ${self.name}
  Role: ${self.role}
  Skills: ${self.skills}
  Availability: ${self.availability replace=AvailabilityPicker}
]}
